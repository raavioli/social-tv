# ─────────────────────────────────────────────────────────────────────────────
# AI TV News — Environment Variables
# Copy this file to .env and fill in your values.
# All keys are optional for demo mode — the app runs with mock data without them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (Docker Compose sets these automatically) ────────────────────────
DATABASE_URL=postgresql://aitvnews:aitvnews_dev@localhost:5432/aitvnews
POSTGRES_USER=aitvnews
POSTGRES_PASSWORD=aitvnews_dev
POSTGRES_DB=aitvnews

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# FREE TIER API KEYS — Sign up links below
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI — GPT-4o-mini + DALL-E 3 image generation
# Free credits: $5 on sign up → https://platform.openai.com/signup
OPENAI_API_KEY=

# ElevenLabs — AI voice synthesis (host narration)
# Free tier: 10,000 chars/month → https://elevenlabs.io/sign-up
ELEVENLABS_API_KEY=

# NewsAPI — Top headlines from 80,000+ sources
# Free tier: 100 requests/day → https://newsapi.org/register
NEWS_API_KEY=

# Reddit API — No key needed for read-only public feeds
# Optional OAuth for higher rate limits → https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Mobile App ────────────────────────────────────────────────────────────────
# Point the Expo app at your local API server
# Use your machine's LAN IP when testing on a physical device (not localhost)
EXPO_PUBLIC_API_URL=http://localhost:3001

# ── Expo / EAS (for CI builds) ────────────────────────────────────────────────
# Get token from: https://expo.dev/accounts/[username]/settings/access-tokens
EXPO_TOKEN=
